--  buildabook.gpr — the outline-language book builder.
--
--  Reads a book's outline.txt + book.conf, resolves {{token}} cross-references,
--  and emits a Typst book.typ plus a number_map.csv audit.  The outline is
--  parsed by an hbnf-generated grammar (outline_grammar.*, checked in); the
--  book.conf reader will pull in hbnf's HBNF_Config crate (with "hbnf_config"),
--  whose code templates are Mustache — mustache is then pulled in
--  transitively, never linked directly here.

project Buildabook is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Create_Missing_Dirs use "True";

   for Main use ("buildabook_cli.adb");

   package Builder is
      for Executable ("buildabook_cli.adb") use "buildabook";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;

end Buildabook;
