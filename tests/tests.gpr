--  tests.gpr — the aunit test harness for buildabook.
--
--  Run via `make check`: builds and runs ./tests.  Depends only on aunit; the
--  buildabook engine units it exercises (Outline, Tokens, Materialize, Build)
--  do not need hbnf (the parsers it generates are checked in).

with "aunit";

project Tests is

   for Languages use ("Ada");
   for Source_Dirs use (".", "../src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Create_Missing_Dirs use "True";

   for Main use ("tests.adb");

   package Builder is
      for Executable ("tests.adb") use "tests";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;

end Tests;
