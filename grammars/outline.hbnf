; outline.hbnf — the book outline language, as an hbnf grammar.
; One entry per line: content (c:id00001  Title) or directive (c:label:Warrant|Wt).
; The grammar is line-oriented: `ws` skips blanks, CR and `#` comments but NOT
; the line feed, so a title or a value (free text to end of line) can never run
; on into the next line; each line, blank or not, ends with an LF.  (The
; engine appends an LF to the file text, so a last line without one parses.)
;
;   content   = prefix ":" uuid [ title ]          c:id00001  Title
;   directive = prefix ":" name ":" value          c:label:Warrant|Wt
;   name is a fixed keyword set; value is free text (a title with no limit on
;   what it holds: words, `|`, digits, blanks inside).

language Ada

include "common.hbnf"

whitespace ws

; -- structure (the root is the FIRST rule) --------------------------------
outline   = *( line )
line      = [ entry ] eol
entry     = content | directive
content   = prefix COLON uuid [ title ]
directive = prefix COLON tail
tail      = name COLON value
value     = [ title ]
eol       = LF

; -- the directive keyword set ---------------------------------------------
name      = "label" | "number" | "count" | "default" | "none"

; -- tokens ------------------------------------------------------------------
prefix     = 'c' | 'p' | 'a' | 'd' | 'n' | 'u' | 's' | 'k'
; a uuid is one token: "id" + digits, or "id" + digits.digits (the k-stack
; minor).  The "id" prefix marks it as a name, not a number.  Flat alternation
; so hbnf emits a single scanner, not a colliding [ PERIOD 1*DIGIT ] pair.
uuid       = 'i' 'd' 1*DIGIT PERIOD 1*DIGIT
           | 'i' 'd' 1*DIGIT
; free text to end of line: it starts at a visible character (the blanks
; before it are white space) and holds anything but LF and CR.
title      = title_start *title_char
title_start = %x21-10FFFF
title_char = %x01-09 | %x0B-0C | %x0E-10FFFF

; -- white space: blanks, CR and comments are skipped between elements; the
; line feed is not, it ends the line ------------------------------------------
ws           = SP | HTAB | CR | comment
comment      = "#" *comment_char
comment_char = %x01-09 | %x0B-0C | %x0E-10FFFF
